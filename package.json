{
  "name": "osan-kids-bridge-frontend",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:guardian": "npm run dev -w @osan-kids-bridge/guardian-web",
    "dev:dashboard": "npm run dev -w @osan-kids-bridge/institution-dashboard",
    "preview": "npm run bundle -w @osan-kids-bridge/phone-preview",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "engines": {
    "node": ">=20"
  }
}
